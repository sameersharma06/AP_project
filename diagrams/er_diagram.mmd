erDiagram
    User ||--o{ HazardReport : creates
    User ||--o{ HazardVote : gives
    HazardReport ||--o{ HazardVote : receives
    User ||--o{ ModerationAction : performs
    HazardReport ||--o{ ModerationAction : has

    User {
        Int id PK
        String name
        String email UK
        String passwordHash
        UserRole role
        DateTime createdAt
    }

    HazardReport {
        Int id PK
        Int userId FK
        String hazardType
        String description
        Float latitude
        Float longitude
        ReportStatus status
        DateTime createdAt
        DateTime updatedAt
        DateTime expiresAt
    }

    HazardVote {
        Int userId PK, FK
        Int reportId PK, FK
        DateTime createdAt
    }

    ModerationAction {
        Int id PK
        Int moderatorId FK
        Int reportId FK
        ModerationActionType action
        String reason
        DateTime createdAt
    }
